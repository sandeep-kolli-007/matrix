{
  "expo": {
    "name": "MATRIX",
    "slug": "matrix",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "matrix",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.sandeepkolli.matrix",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0D10",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.sandeep_kolli_007.matrix"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro",
      "name": "MATRIX",
      "shortName": "MATRIX",
      "lang": "en",
      "themeColor": "#0B0D10",
      "description": "MATRIX — your personal operating system."
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0D10"
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "baseUrl": "/matrix"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "29b03dc4-d4fb-4f4c-a14b-84c7c96b4955"
      }
    },
    "owner": "sandeep_kolli_007"
  }
}
