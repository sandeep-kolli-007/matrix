# MATRIX is the LifeOS product repository HQ should operate on.
LIFEOS_REPO=sandeep-kolli-007/matrix

# Optional GitHub live integration. Without a token, repository actions stay in dry-run mode.
GITHUB_TOKEN=

# Optional OpenAI-compatible model gateway. Without it, agents use deterministic local fallbacks.
# Examples include a hosted gateway or a local compatible server.
HQ_MODEL_BASE_URL=
HQ_MODEL_API_KEY=
HQ_MODEL_NAME=